# Optional startup settings. Copy to .env in the directory where you start the app.
# Never commit .env. Configure remote backups in the web UI instead.
PROMPTLIB_HOST=127.0.0.1
PROMPTLIB_PORT=8000
PROMPTLIB_DB_NAME=promptlibrary.db
PROMPTLIB_DEBUG=false
PROMPTLIB_ALLOWED_HOSTS='["127.0.0.1","localhost","[::1]"]'
# PROMPTLIB_DATA_DIR=/absolute/path/to/library
# PROMPTLIB_AUTH_USERNAME=promptlibrary
# Set your own random password of at least 16 characters before network or Docker use.
# PROMPTLIB_AUTH_PASSWORD=
# For an HTTPS proxy, also add its actual hostname to PROMPTLIB_ALLOWED_HOSTS.
# PROMPTLIB_PUBLIC_ORIGIN=https://library.example.org
PROMPTLIB_MAX_REQUEST_BYTES=27262976
